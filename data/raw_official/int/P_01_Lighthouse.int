[P_01_Lighthouse_CnvCaveGuards]
Speech_-001L=(null)
Speech_0001L=QUINTON: Hey!  Stefano... look here!
Speech_0002L=STEFANO: What? What is it?
Speech_0003L=QUINTON: There's some kind of caves back here... look...
Speech_-001L=(null)
Speech_0006L=STEFANO: Look... there's some kind of old bridge there...
Speech_0021L=QUINTON: You know...  I heard that smugglers used to use these old caves...
Speech_0022L=STEFANO: Smugglers?
Speech_0023L=QUINTON: Yeah...they probably had all sorts of secret passages and tunnels down here. C'mon...
Note_0031L=There may be secret passageways in the caves.
Speech_-001L=(null)
Speech_0011L=STEFANO: Whoa... careful
Speech_0012L=QUINTON: It's safe... don't worry...
Speech_-001L=(null)
Speech_0024L=STEFANO: Where are you going?  Careful.  Maybe it's not safe...
Speech_0025L=QUINTON: Don't be a fool.
Speech_0026L=STEFANO: Old caves like this are dangerous... I'm not going any further.
Speech_0027L=QUINTON: Fine... do what you like...
Speech_-001L=(null)
Speech_0028L=STEFANO: Alright...  well, I'm gonna head back...
Speech_0029L=QUINTON: Ok.  I'm going to stay here... enjoy the view...
Speech_-001L=(null)
Speech_0032L=(null)
Speech_-001L=(null)
Speech_0033L=(null)
