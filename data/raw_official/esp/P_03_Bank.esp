[P_03_Bank_InterroKeypad]
Speech_-001L=(null)
Speech_0001L=Hola, Paco...
Speech_0002L=¡Oh, no, un ladrón! No me hagas daño...
Speech_0005L=Pues dime el código.
Speech_0008L=Esta puerta está rota, y no sé arreglarla. Tengo que avisar a la compañía de seguridad.
Speech_0009L=¿Hay otra forma de entrar?
Speech_0010L=Si fueras un ratón, a lo mejor. ¿Quieres que llame a la compañía de tu parte?
Speech_0011L=No, déjalo. Ya encontraré algo.
Speech_0013L=Si quieres que llame para que lo arreglen, dímelo.
Speech_0014L=Esto no hace más que estropearse.
Speech_-001L=(null)
Speech_0015L=Hola, Paco...
Speech_0016L=¿Quién eres? ¿Qué quieres?
Speech_0017L=Darte las gracias por arreglar el teclado de la puerta.
Speech_0018L=Ya, a Paco siempre le toca hacer el trabajo sucio.
Speech_0019L=¿Te importa decirme el código de la puerta?
