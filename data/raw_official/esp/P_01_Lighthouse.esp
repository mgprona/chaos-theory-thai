[P_01_Lighthouse_CnvCaveGuards]
Speech_-001L=(null)
Speech_0001L=¡Eh, Stefano! ¡Mira aquí!
Speech_0002L=¿Qué pasa?
Speech_0003L=Hay una especie de cuevas. Mira...
Speech_-001L=(null)
Speech_0006L=Mira. Parece que hay un viejo puente...
Speech_0021L=Tengo entendido que en estas cavernas había contrabandistas.
Speech_0022L=¿Contrabandistas?
Speech_0023L=Sí. Seguro que tenían esto sembrado de pasadizos y túneles secretos. Vamos.
Note_0031L=Puede haber pasillos secretos en las cuevas.
Speech_-001L=(null)
Speech_0011L=Buff... Cuidado...
Speech_0012L=No te preocupes, es sólido.
Speech_-001L=(null)
Speech_0024L=¿Adónde vas? Ten cuidado, puede ser peligroso.
Speech_0025L=No seas idiota.
Speech_0026L=Me dan mala espina las cuevas. No pienso seguir.
Speech_0027L=Haz lo que te dé la gana.
Speech_-001L=(null)
Speech_0028L=Muy bien, yo me doy la vuelta.
Speech_0029L=Yo me quedo a disfrutar del paisaje.
Speech_-001L=(null)
Speech_0032L=(null)
Speech_-001L=(null)
Speech_0033L=(null)
