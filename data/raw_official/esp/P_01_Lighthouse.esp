[P_01_Lighthouse_IntThunder]
Speech_-001L=(null)
Speech_0001L=Bú.
Speech_0002L=¡Ah! Sabía que vendrías.
Speech_0003L=¿Qué?
Speech_0004L=Llevo toda la vida esperándote. Sabía que vendrías con el trueno y las sombras, para acabar lo que empezaste.
