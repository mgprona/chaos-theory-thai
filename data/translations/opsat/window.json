    "FirstRun": {
      "_source": "Window",
      "Caption": {
        "en": "Initial Configuration",
        "fr": "",
        "de": "",
        "es": "",
        "it": "",
        "th": "การกำหนดค่าเริ่มต้น"
      },
      "LowMemory": {
        "en": "Unreal has detected that you have %i megabytes of memory available. To improve performance, the \"Low Detail Textures\" and \"Low Sound Quality\" options have been enabled.  You may change this settings in the \"Performance Settings\" menu.",
        "fr": "",
        "de": "",
        "es": "",
        "it": "",
        "th": "Unreal ตรวจพบว่าคุณมีหน่วยความจำที่ใช้งานได้ %i เมกะไบต์ เพื่อปรับปรุงประสิทธิภาพการทำงาน ระบบจึงเปิดใช้ตัวเลือก \"พื้นผิวรายละเอียดต่ำ\" และ \"คุณภาพเสียงต่ำ\" คุณสามารถเปลี่ยนการตั้งค่านี้ได้ในเมนู \"การตั้งค่าประสิทธิภาพ\""
      },
      "NonMMX": {
        "en": "Unreal has detected that you're using a non-MMX PC. Based on this, the sound playback rate has been set to use the least CPU power. You may change this settings in the \"Advanced Options / Audio\" menu.",
        "fr": "",
        "de": "",
        "es": "",
        "it": "",
        "th": "Unreal ตรวจพบว่าคุณใช้พีซีที่ไม่รองรับชุดคำสั่ง MMX ด้วยเหตุนี้ อัตราการเล่นเสียงจึงถูกตั้งให้ใช้พลังงาน CPU น้อยที่สุด คุณสามารถเปลี่ยนการตั้งค่านี้ได้ในเมนู \"ตัวเลือกขั้นสูง / ระบบเสียง\""
      },
      "Starting": {
        "en": "Unreal is starting up with new settings. If you experience any problems, please read the Troubleshooting section of the Release Notes in the \"Start\" menu.",
        "fr": "",
        "de": "",
        "es": "",
        "it": "",
        "th": "Unreal กำลังเริ่มต้นด้วยการตั้งค่าใหม่ หากคุณพบปัญหาใดๆ โปรดอ่านหัวข้อการแก้ไขปัญหาในเอกสารข้อมูลประจำรุ่นจากเมนู \"Start\""
      }
    },
